# Carelo Production Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_DB=carelo_db
POSTGRES_USER=carelo_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# JWT Secret Key (generate a strong random string)
JWT_SECRET_KEY=CHANGE_THIS_TO_STRONG_RANDOM_STRING_AT_LEAST_32_CHARS

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Allowed Origins (comma-separated list of domains)
# Example: https://carelo.de,https://www.carelo.de
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Frontend API Base URL
# For production with nginx reverse proxy, use: /api
# For direct backend access, use: https://api.your-domain.com
VITE_API_BASE_URL=/api

# Storage Configuration
STORAGE_TYPE=local
# For S3 storage, uncomment and configure:
# STORAGE_TYPE=s3
# S3_BUCKET_NAME=carelo-files
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...



