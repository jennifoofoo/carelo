# Carelo — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git!

# ── Required for AI features ──────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day — no credit card required
GEMINI_API_KEY=your-gemini-api-key-here

# ── Required for authentication ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# ── Frontend ──────────────────────────────────────────────────────────────────
# Local dev: set this to the backend URL
# Railway / production: leave EMPTY ("") — the app uses window.location.origin (same domain)
VITE_API_BASE_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave commented out → SQLite (carelo.db) is used automatically
# Railway: add the PostgreSQL plugin → DATABASE_URL is set automatically by Railway
#          Without PostgreSQL, data is lost on every redeploy!
# DATABASE_URL=postgresql://user:password@localhost:5432/carelo

# ── Cache (optional, falls back to in-memory) ─────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────
# CORS: add your Railway frontend URL here (comma-separated, no trailing slash)
# Example: ALLOWED_ORIGINS=https://carelo-production.up.railway.app
# ALLOWED_ORIGINS=https://your-app.railway.app

# Set to false in development if you want SQL query logging
DEBUG=false

# ── Demo Data ─────────────────────────────────────────────────────────────────
# SKIP_DEMO_DATA=true   → demo data is never created (default)
# SKIP_DEMO_DATA=false  → demo data is created on first startup (skipped if already exists)
# RESET_DEMO_DATA=true  → combined with SKIP_DEMO_DATA=false: wipes and recreates demo data on every startup
SKIP_DEMO_DATA=true
# RESET_DEMO_DATA=false

# ── File Storage ──────────────────────────────────────────────────────────────
# STORAGE_TYPE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=eu-central-1
